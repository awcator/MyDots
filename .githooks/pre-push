#!/usr/bin/env bash
# pre-push hook — block push if sensitive content is detected
# Install: cp this to .git/hooks/pre-push && chmod +x .git/hooks/pre-push

RED='\033[0;31m'
NC='\033[0m'

# Patterns that should NEVER be pushed
PATTERNS=(
    'sk-[a-zA-Z0-9]\{20,\}'          # API keys (sk-...)
    'AKIA[0-9A-Z]\{16\}'             # AWS access keys
    'password\s*=\s*[^$]'            # Hardcoded passwords
    'BEGIN.*PRIVATE KEY'             # Private keys
    'ghp_[a-zA-Z0-9]\{36\}'         # GitHub tokens
    'xox[baprs]-[a-zA-Z0-9-]\+'    # Slack tokens
    'oathtool.*--totp [A-Z2-7]\{16,\}'  # TOTP secrets (base32 seeds)
    'token=[0-9a-f-]\{36\}'         # Token assignments (e.g. duckdns)
)

FOUND=0

# Read the push info from stdin to determine what's being pushed
while read local_ref local_sha remote_ref remote_sha; do
    # Skip delete pushes
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
        continue
    fi

    # Determine the range of commits being pushed
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        # New branch — check all commits not on remote
        RANGE="$local_sha --not --remotes"
    else
        # Existing branch — only check new commits
        RANGE="$remote_sha..$local_sha"
    fi

    # Scan only the DIFF of unpushed commits (new lines only)
    for pattern in "${PATTERNS[@]}"; do
        matches=$(git diff "$remote_sha" "$local_sha" 2>/dev/null | grep "^+" | grep -v "^+++" | grep "$pattern" || true)
        if [[ -n "$matches" ]]; then
            echo -e "${RED}[BLOCKED]${NC} Potential secret in unpushed changes matching:"
            echo "  $pattern"
            echo "$matches" | sed 's/^+/  /' | head -5
            echo ""
            FOUND=1
        fi
    done

    # Check if any sensitive files were added in unpushed commits
    SENSITIVE_FILES=(".env" "credentials.json" "*.pem" "*.key" "id_rsa" "id_ed25519")
    for pat in "${SENSITIVE_FILES[@]}"; do
        found=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null | grep -E "(^|/)${pat}$" || true)
        if [[ -n "$found" ]]; then
            echo -e "${RED}[BLOCKED]${NC} Sensitive file in unpushed commits: $found"
            FOUND=1
        fi
    done
done

if [[ $FOUND -eq 1 ]]; then
    echo ""
    echo -e "${RED}Push blocked!${NC} Remove secrets or use: git push --no-verify (at your own risk)"
    exit 1
fi

exit 0
