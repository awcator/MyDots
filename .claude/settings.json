{
  "autoCompactEnabled": true,
  "awaySummaryEnabled": true,
  "enabledPlugins": {},
  "env": {
    "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/sbin/brave",
    "PLAYWRIGHT_MCP_NO_SANDBOX": "1",
    "PLAYWRIGHT_MCP_SHARED_BROWSER_CONTEXT": "1",
    "PLAYWRIGHT_MCP_USER_DATA_DIR": "/home/awcator/.config/BraveSoftware/Brave-Browser",
    "SUDO_ASKPASS": "/home/awcator/.local/bin/claude-askpass",
    "TMUX_TMPDIR": "/var/tmp"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "notify-send 'Claude Code' 'Claude Code needs your attention'",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // \"file\"' | { read -r f; notify-send -i document-save 'Claude Code' \"File modified: $(basename \"$f\")\" 2\u003e/dev/null || true; }",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "bash /home/awcator/.claude/claude-mirror.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.command // empty' | { read -r cmd; [ -n \"$cmd\" ] \u0026\u0026 echo \"$cmd\" \u003e\u003e /home/awcator/.bash_history; }",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "jq -r '\"⚡ \" + (.tool_input.command // \"unknown\" | if length \u003e 100 then .[0:100] + \"…\" else . end)' | { read -r msg; notify-send -i utilities-terminal 'Claude Code — Running' \"$msg\" 2\u003e/dev/null || true; }",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "jq -r '\"Task completed ✔\\n\" + (.last_assistant_message // \"Done\" | split(\"\\n\")[0] | if length \u003e 120 then .[0:120] + \"…\" else . end)' | { read -r line1; read -r line2; notify-send -i dialog-information 'Claude Code' \"${line1}\n${line2}\" 2\u003e/dev/null || true; }",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.*:*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "mcp__web-search__web_search",
      "NotebookEdit",
      "Agent",
      "Skill"
    ],
    "deny": [
      "WebSearch"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "/home/awcator/.claude/statusline.sh",
    "padding": 2,
    "type": "command"
  },
  "tui": "fullscreen",
  "verbose": true
}