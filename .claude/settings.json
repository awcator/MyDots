{
  "env": {
    "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/sbin/brave",
    "PLAYWRIGHT_MCP_NO_SANDBOX": "1",
    "PLAYWRIGHT_MCP_SHARED_BROWSER_CONTEXT": "1",
    "PLAYWRIGHT_MCP_USER_DATA_DIR": "/home/awcator/.config/BraveSoftware/Brave-Browser",
    "SUDO_ASKPASS": "/home/awcator/.local/bin/claude-askpass",
    "TMUX_TMPDIR": "/var/tmp"
  },
  "permissions": {
    "allow": [
      "Bash(.*:*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "mcp__web-search__web_search",
      "NotebookEdit",
      "Agent",
      "Skill"
    ],
    "deny": [
      "WebSearch"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send -t 5000 'Claude Code' 'Claude Code needs your attention'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/home/awcator/Documents/whatapp/mcp/notify-whatsapp.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/home/awcator/Documents/whatapp/mcp/idle-reminder.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ScheduleWakeup|CronCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/awcator/Documents/whatapp/mcp/notify-loop.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // \"file\"' | { read -r f; notify-send -t 5000 -i document-save 'Claude Code' \"File modified: $(basename \"$f\")\" 2>/dev/null || true; }",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/awcator/.claude/claude-mirror.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | { read -r cmd; [ -n \"$cmd\" ] && echo \"$cmd\" >> /home/awcator/.bash_history; }",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "jq -r '\"⚡ \" + (.tool_input.command // \"unknown\" | if length > 100 then .[0:100] + \"…\" else . end)' | { read -r msg; notify-send -t 5000 -i utilities-terminal 'Claude Code — Running' \"$msg\" 2>/dev/null || true; }",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"Task completed ✔\\n\" + (.last_assistant_message // \"Done\" | split(\"\\n\")[0] | if length > 120 then .[0:120] + \"…\" else . end)' | { read -r line1; read -r line2; notify-send -t 5000 -i dialog-information 'Claude Code' \"${line1}\n${line2}\" 2>/dev/null || true; }",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/awcator/Documents/whatapp/mcp/idle-reminder.sh --stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/awcator/Documents/whatapp/mcp/idle-reminder.sh --stop",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/awcator/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {},
  "effortLevel": "medium",
  "awaySummaryEnabled": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "opus"
}
