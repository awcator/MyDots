#!/bin/bash
# Wrapper to use git-credential-store in read-only mode and correctly route credentials.
# Intercepts 'store' and 'erase' commands to prevent writes to the immutable ~/.git-credentials file.

if [ "$1" = "get" ]; then
    path=""
    host=""
    while read -r line; do
        [[ -z "$line" ]] && break
        if [[ "$line" == path=* ]]; then path="${line#path=}"; fi
        if [[ "$line" == host=* ]]; then host="${line#host=}"; fi
    done

    # Extract the organization/username from the first part of the path
    org="${path%%/*}"

    # Try to find a credential specifically for this org
    match=""
    if [ -n "$org" ] && [ -n "$host" ]; then
        match=$(grep "@${host}/${org}" ~/.git-credentials | head -n 1)
    fi

    if [ -n "$match" ]; then
        # Use the org-specific credential
        echo "$match" | sed -n 's|https://\([^:]*\):\([^@]*\)@.*|username=\1\npassword=\2|p'
    else
        # Fallback to the first credential (the default)
        head -n 1 ~/.git-credentials | sed -n 's|https://\([^:]*\):\([^@]*\)@.*|username=\1\npassword=\2|p'
    fi
elif [ "$1" = "store" ] || [ "$1" = "erase" ]; then
    # Discard standard input silently and exit with success (0)
    cat > /dev/null
    exit 0
else
    # Fallback for any other commands
    exit 0
fi
