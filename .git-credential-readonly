#!/bin/bash
# Wrapper to use git-credential-store in read-only mode.
# Intercepts 'store' and 'erase' commands to prevent writes to the immutable ~/.git-credentials file.

if [ "$1" = "get" ]; then
    # Pass 'get' requests to the standard store helper so it reads the file
    git credential-store get
elif [ "$1" = "store" ] || [ "$1" = "erase" ]; then
    # Discard standard input silently and exit with success (0)
    cat > /dev/null
    exit 0
else
    # Fallback for any other commands
    exit 0
fi
