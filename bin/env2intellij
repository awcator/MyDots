#!/usr/bin/env python3
import sys
import os

def main():
    if len(sys.argv) < 2:
        print(f"Usage: {os.path.basename(sys.argv[0])} <path_to_env_file>")
        sys.exit(1)

    env_file = sys.argv[1]

    if not os.path.isfile(env_file):
        print(f"Error: File '{env_file}' not found.")
        sys.exit(1)

    env_vars = []

    with open(env_file, 'r') as f:
        for line in f:
            line = line.strip()

            # Skip empty lines and comments
            if not line or line.startswith('#'):
                continue

            # Remove "export " prefix if it exists
            if line.startswith('export '):
                line = line[7:].strip()

            if '=' in line:
                # Split only on the first equals sign
                key, val = line.split('=', 1)

                key = key.strip()
                val = val.strip()

                # Remove surrounding double quotes or single quotes from the value
                if len(val) >= 2 and ((val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'"))):
                    val = val[1:-1]

                env_vars.append(f"{key}={val}")

    # Join with semicolons and append a trailing semicolon
    if env_vars:
        result = ";".join(env_vars) + ";"
        print(result)
    else:
        print("No valid environment variables found.")

if __name__ == '__main__':
    main()
