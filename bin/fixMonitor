#!/bin/bash
POSITION="${1:-right}"
XRANDR_OUT=$(xrandr --current)

PRIMARY=$(echo "$XRANDR_OUT" | awk '/ connected/ {print $1}' | grep -i 'edp' | head -n1)
[ -z "$PRIMARY" ] && PRIMARY=$(echo "$XRANDR_OUT" | awk '/ connected primary/ {print $1}')
[ -z "$PRIMARY" ] && PRIMARY=$(echo "$XRANDR_OUT" | awk '/ connected/ {print $1}' | head -n1)

[ -z "$PRIMARY" ] && { echo "Error: No primary display found."; exit 1; }

DRM_CONNECTED=$(cat /sys/class/drm/*/status 2>/dev/null | grep -cw "^connected")
XRANDR_CONNECTED=$(echo "$XRANDR_OUT" | grep -c " connected")
PHYSICAL_CONNECTED=$(( DRM_CONNECTED > XRANDR_CONNECTED ? DRM_CONNECTED : XRANDR_CONNECTED ))
CMD="xrandr"

if [ "$PHYSICAL_CONNECTED" -le 1 ]; then
    echo "Restoring to laptop display (no external monitors detected)."
    for out in $(echo "$XRANDR_OUT" | awk '/ connected| disconnected/ {print $1}'); do
        [ "$out" != "$PRIMARY" ] && CMD="$CMD --output $out --off"
    done
    CMD="$CMD --output $PRIMARY --auto --primary"
    eval "$CMD"
    exit 0
fi

EXTERNAL=$(echo "$XRANDR_OUT" | awk '/ connected/ {print $1}' | grep -vi 'edp' | head -n1)
[ -z "$EXTERNAL" ] && { echo "Error: No external display found in xrandr."; exit 1; }

echo "Primary: $PRIMARY | External: $EXTERNAL | Position: $POSITION"

for out in $(echo "$XRANDR_OUT" | awk '/ disconnected/ {print $1}'); do
    CMD="$CMD --output $out --off"
done

CMD="$CMD --output $PRIMARY --auto --primary"

case "$POSITION" in
    right)             CMD="$CMD --output $EXTERNAL --auto --right-of $PRIMARY" ;;
    left)              CMD="$CMD --output $EXTERNAL --auto --left-of $PRIMARY" ;;
    above|top|up)      CMD="$CMD --output $EXTERNAL --auto --above $PRIMARY" ;;
    below|bottom|down) CMD="$CMD --output $EXTERNAL --auto --below $PRIMARY" ;;
    *) echo "Usage: fixMonitor [right|left|above|below]"; exit 1 ;;
esac

eval "$CMD"
echo "Done."
