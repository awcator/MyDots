#!/bin/bash
# claudeload — switch Claude Code backend in current shell
# Usage: source /path/to/MyDots/bin/claudeload <profile> [model]
#
# Backends: copilot | junie | devin | deepseek | antigravity | aistudio | codexproxy
# Proxies run foreground in tmux session 'proxies' (spawned only if port is down).
# Local proxy checkouts default to siblings of this repo; override their paths
# with the backend-specific *_DIR or *_REPO environment variable.

# ══════════════════════════════════════════════════════════════════════════════
#  Constants
# ══════════════════════════════════════════════════════════════════════════════

export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${CLAUDELOAD_MAX_OUTPUT_TOKENS:-128000}"

_CLD_SELF="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
_CLD_ROOT="$(dirname "$(dirname "$_CLD_SELF")")"
_CLD_SIBLINGS="$(dirname "$_CLD_ROOT")"

# ANSI helpers (prefixed _CL_ to avoid clashing with .bashrc PS1 vars)
_CL_B=$'\033[1m'  _CL_C=$'\033[36m'  _CL_G=$'\033[32m'
_CL_Y=$'\033[33m' _CL_R=$'\033[31m'  _CL_D=$'\033[2m'  _CL_0=$'\033[0m'

# ══════════════════════════════════════════════════════════════════════════════
#  Logging & Error Handling
# ══════════════════════════════════════════════════════════════════════════════

_cl_log()  { [[ -z "${CLAUDELOAD_QUIET:-}" ]] && echo "$@"; return 0; }
_cl_warn() { [[ -z "${CLAUDELOAD_QUIET:-}" ]] && echo "$@" >&2; return 0; }
_cl_die()  { echo "$*" >&2; return 1; }

# ══════════════════════════════════════════════════════════════════════════════
#  Environment Management
# ══════════════════════════════════════════════════════════════════════════════

# Clear every ANTHROPIC_* var from previous sessions.  A stale ANTHROPIC_API_KEY
# sitting next to a proxy's ANTHROPIC_AUTH_TOKEN triggers the "auth may not work
# as expected" warning in Claude Code.
_cl_clear_env() {
  local v
  while IFS= read -r v; do unset -v "$v"; done < <(compgen -v 'ANTHROPIC_')
  # DeepSeek deliberately sets this to low. Do not carry that constraint into
  # another backend, where it can silently reduce Codex reasoning quality.
  unset CLAUDE_CODE_EFFORT_LEVEL
  # Only a backend that knows its model's window (strata) declares this; carry
  # it across a switch and Claude Code sizes every later model to that window.
  unset CLAUDE_CODE_MAX_CONTEXT_TOKENS
}

# Export the six model env vars Claude Code uses.
#   _cl_export_models <base> [fast] [sonnet]
# Defaults: fast → base, sonnet → base.
_cl_export_models() {
  local base="$1" fast="${2:-$1}" sonnet="${3:-$1}"
  export ANTHROPIC_MODEL="$base"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$base"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$sonnet"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$fast"
  export ANTHROPIC_SMALL_FAST_MODEL="$fast"
  export CLAUDE_CODE_SUBAGENT_MODEL="$fast"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Proxy Management (tmux)
# ══════════════════════════════════════════════════════════════════════════════

# _cl_port_up <port> → 0 if something is already listening
_cl_port_up() {
  ss -ltn 2>/dev/null | awk '{print $4}' | \grep -qE "(^|:)$1$" && return 0
  curl -sf -o /dev/null --max-time 1 "http://localhost:$1/v1/models" 2>/dev/null
}

# _cl_spawn_proxy <name> <port> <cmd...>
# Run <cmd> in a foreground tmux window inside the 'proxies' session,
# unless the port is already up.  Waits up to 30 s for the port.
_cl_spawn_proxy() {
  local name="$1" port="$2"; shift 2

  if _cl_port_up "$port"; then
    _cl_log "$name: already running on :$port"
    return 0
  fi

  _cl_log "$name: starting on :$port (foreground in tmux window)…"

  if ! command -v tmux >/dev/null 2>&1; then
    _cl_warn "$name: tmux not found — running detached"
    "$@" >/dev/null 2>&1 &
  elif [[ -n "${TMUX:-}" ]]; then
    tmux new-window -d -n "$name" "$@"
  elif ! tmux has-session -t proxies 2>/dev/null; then
    tmux new-session -d -s proxies -n "$name" "$@"
  else
    tmux new-window -d -t proxies -n "$name" "$@"
  fi

  local i
  for i in {1..30}; do
    _cl_port_up "$port" && return 0
    sleep 1
  done
  _cl_warn "$name: warning — :$port not up after 30 s"
  return 1
}

# ══════════════════════════════════════════════════════════════════════════════
#  Data Helpers
# ══════════════════════════════════════════════════════════════════════════════

_cl_require_litellm() {
  local name="$1"
  command -v litellm >/dev/null 2>&1 || export PATH="$PATH:$HOME/.local/bin"
  if ! command -v litellm >/dev/null 2>&1; then
    _cl_die "$name: litellm not found! Install via: uv tool install 'litellm[proxy]'"
    return 1
  fi
}

_cl_require_node() {
  local name="$1"
  if ! command -v node >/dev/null 2>&1; then
    _cl_die "$name: node not found (install Node.js)"
    return 1
  fi
}

_cl_read_junie_api_key() {
  local v="${JUNIE_API_KEY:-}"
  [[ -n "$v" ]] || return 1
  printf '%s' "$v"
}

# Keep generated LiteLLM config files in the user's cache directory.
_cl_config_file() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/claudeload"
  mkdir -p "$dir" || return 1
  printf '%s/%s' "$dir" "$1"
}

# ══════════════════════════════════════════════════════════════════════════════

# Fetch JSON from a URL with optional Authorization header.
_cl_fetch_json() {
  local url="$1" auth="${2:-}"
  if [[ -n "$auth" ]]; then
    curl -sf "$url" -H "Authorization: Bearer $auth" 2>/dev/null
  else
    curl -sf "$url" 2>/dev/null
  fi
}

# Keep non-conversational endpoints out of Claude Code's model picker.
_cl_filter_chat_models() {
  \grep -viE 'embedding|whisper|tts|dall-e|babbage|davinci|moderation|text-search|search|similarity|trajectory|compaction|image'
}

_cl_sort_models() {
  if sort -V </dev/null >/dev/null 2>&1; then sort -V; else sort; fi
}

# Run inline Python that reads JSON from $_CL_JSON env var and prints TSV.
#   _cl_models_to_tsv <json> <python_code>
# Extra env vars can be prepended by the caller (e.g. _CL_EXTRA="val" _cl_models_to_tsv ...).
_cl_models_to_tsv() {
  local tmp_json
  tmp_json="$(mktemp)"
  printf "%s" "$1" > "$tmp_json"
  _CL_JSON_FILE="$tmp_json" python3 -c "import os; os.environ['_CL_JSON'] = open(os.environ['_CL_JSON_FILE']).read();"$'
'"$2"
  local rc=$?
  rm -f "$tmp_json"
  return $rc
}

# Natural-sort + pick the last match from a newline-separated list.
#   _cl_derive_fast <model_list> <grep_pattern> [exclude_pattern]
_cl_derive_fast() {
  local models="$1" pattern="$2" exclude="${3:-}"
  if [[ -n "$exclude" ]]; then
    printf '%s\n' "$models" | \grep -iE "$pattern" | \grep -viE "$exclude" | _cl_sort_models | tail -1
  else
    printf '%s\n' "$models" | \grep -iE "$pattern" | _cl_sort_models | tail -1
  fi
}

# Lowercased vendor token from a model id (claude/gpt/gemini/…).
_cl_vendor_of() {
  local s="${1,,}" v
  s="${s//_/-}"
  for v in claude gpt gemini glm deepseek grok kimi nemotron swe inkling mai qwen; do
    [[ "$s" == *"$v"* ]] && { echo "$v"; return 0; }
  done
  echo "${s%%[-0-9]*}"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Interactive Model Picker
# ══════════════════════════════════════════════════════════════════════════════

# _cl_pick "<title>" "<tsv>"
# Print a colored numbered table to stderr, read a choice from the terminal,
# echo the chosen id to stdout.  TSV columns: id <TAB> label <TAB> status.
# Returns 1 if the user quits.
_cl_pick() {
  local title="$1" tsv="$2"
  local out
  out="$(printf '%s' "$tsv" | python3 "$_CLD_ROOT/bin/cl_picker.py" "$title")"
  local rc=$?
  if [[ $rc -eq 0 && -n "$out" ]]; then
    printf '%s' "$out"
    return 0
  fi
  return 1
}

_cl_print_status() {
  local endpoint="${ANTHROPIC_BASE_URL:-not configured}"
  printf '%b\n' "${_CL_C}╭─ Claude Code backend${_CL_0}"
  printf '%b\n' "${_CL_C}│${_CL_0} Endpoint   ${_CL_B}${endpoint}${_CL_0}"
  printf '%b\n' "${_CL_C}│${_CL_0} Main       ${ANTHROPIC_MODEL:-not configured}"
  printf '%b\n' "${_CL_C}│${_CL_0} Opus       ${ANTHROPIC_DEFAULT_OPUS_MODEL:-not configured}"
  printf '%b\n' "${_CL_C}│${_CL_0} Sonnet     ${ANTHROPIC_DEFAULT_SONNET_MODEL:-not configured}"
  printf '%b\n' "${_CL_C}│${_CL_0} Haiku/Fast ${ANTHROPIC_SMALL_FAST_MODEL:-not configured}"
  printf '%b\n' "${_CL_C}│${_CL_0} Subagent   ${CLAUDE_CODE_SUBAGENT_MODEL:-not configured}"
  if [[ "$endpoint" == http://127.0.0.1:* || "$endpoint" == http://localhost:* ]]; then
    local health_url="${endpoint%/}/health"
    if curl -sf -o /dev/null --max-time 1 "$health_url" 2>/dev/null; then
      printf '%b\n' "${_CL_C}│${_CL_0} Service    ${_CL_G}healthy${_CL_0}"
    else
      printf '%b\n' "${_CL_C}│${_CL_0} Service    ${_CL_Y}not checked / unavailable${_CL_0}"
    fi
  fi
  printf '%b\n' "${_CL_C}╰────────────────────────────────────────${_CL_0}"
}

# _cl_select_model "<title>" "<tsv>" [override]
# If override is non-empty, echo it; otherwise run _cl_pick.
_cl_select_model() {
  local title="$1" tsv="$2" override="${3:-}"
  if [[ -n "$override" ]]; then
    printf '%s' "$override"
    return 0
  fi
  _cl_pick "$title" "$tsv" || { echo "  cancelled" >&2; return 1; }
}

# ══════════════════════════════════════════════════════════════════════════════
#  Shared Python: natural-sort TSV rows
# ══════════════════════════════════════════════════════════════════════════════
# Every backend's Python TSV builder needs the same nkey() sort.  This variable
# holds the shared fragment so we define it once.
_CL_PY_SORT='
import re
def _nkey(r):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", r[0])]
'

# ══════════════════════════════════════════════════════════════════════════════
#  Backend: Copilot  (port 4141, copilot-api)
# ══════════════════════════════════════════════════════════════════════════════

_cl_backend_copilot() {
  local model_override="${1:-}"
  local base_url="${COPILOT_BASE_URL:-http://localhost:4141}"
  base_url="${base_url%/}"

  _cl_clear_env
  export ANTHROPIC_BASE_URL="$base_url"
  export ANTHROPIC_AUTH_TOKEN="${COPILOT_AUTH_TOKEN:-dummy}"

  if [[ -z "${COPILOT_BASE_URL:-}" ]]; then
    if ! _cl_port_up 4141 && ! command -v npx >/dev/null 2>&1; then
      _cl_die "copilot: npx not found (install Node.js and npm)"
      return 1
    fi
    _cl_spawn_proxy copilot 4141 \
      npx -y copilot-api@latest start --account-type "${COPILOT_ACCOUNT_TYPE:-business}" || return 1
  fi

  local models_json tsv all base
  models_json="$(_cl_fetch_json "$base_url/v1/models" "${COPILOT_AUTH_TOKEN:-}")"
  tsv="$(_cl_models_to_tsv "$models_json" "${_CL_PY_SORT}"'
import json, os
models = json.loads(os.environ["_CL_JSON"]).get("data", [])
ids = {m["id"] for m in models if isinstance(m, dict) and m.get("id")}
for mid in sorted(ids, key=lambda mid: _nkey((mid,))):
    print("%s\t\t" % mid)
' 2>/dev/null | _cl_filter_chat_models)"
  if [[ -z "$tsv" ]]; then
    _cl_die "copilot: couldn't fetch models from $base_url"
    return 1
  fi

  all="$(printf '%s\n' "$tsv" | cut -f1)"
  base="$(_cl_select_model "Copilot models ($base_url)" "$tsv" "$model_override")" \
    || return 1

  # Dynamically derive sonnet (mid-tier) and fast (lightest) from same vendor
  local vendor sonnet fast
  vendor="$(_cl_vendor_of "$base")"
  # Mid-tier: same vendor, prefer "sonnet" variant, else largest capable non-base
  sonnet="$(_cl_derive_fast "$all" "^${vendor}.*sonnet")"
  [[ -z "$sonnet" ]] && sonnet="$(printf '%s\n' "$all" \
    | \grep -iE "^${vendor}" \
    | \grep -viE 'mini|lite|haiku|flash|embed|compaction|trajectory|codex|copilot' \
    | \grep -Fxv "$base" | _cl_sort_models | tail -1)"
  # Fast: same vendor, prefer mini/haiku/flash/lite variant
  fast="$(_cl_derive_fast "$all" "^${vendor}.*(mini|haiku|flash|lite)")"
  [[ -z "$fast" ]] && fast="$(printf '%s\n' "$all" \
    | \grep -iE "^${vendor}" | _cl_sort_models | head -1)"
  : "${sonnet:=$base}" "${fast:=$base}"

  _cl_export_models "$base" "$fast" "$sonnet"
  _cl_log "Loaded: $ANTHROPIC_MODEL (copilot, $base_url)" \
          "— sonnet: $ANTHROPIC_DEFAULT_SONNET_MODEL," \
          "haiku: $ANTHROPIC_SMALL_FAST_MODEL"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Backend: Junie API  (default port 4143)
# ══════════════════════════════════════════════════════════════════════════════

_cl_backend_junie() {
  local model_override="${1:-}"
  local port="${JUNIE_PORT:-4143}"
  local repo_dir="${JUNIE_REPO:-$_CLD_SIBLINGS/junie-api}"

  _cl_clear_env

  export ANTHROPIC_BASE_URL="http://localhost:$port"
  export ANTHROPIC_AUTH_TOKEN="${JUNIE_AUTH_TOKEN:-dummy}"

  if ! _cl_port_up "$port"; then
    _cl_require_node "junie" || return 1
    local key
    key="$(_cl_read_junie_api_key)" || {
      _cl_die "junie: JUNIE_API_KEY not found in environment"
      return 1
    }
    if [[ ! -f "$repo_dir/dist/main.js" ]]; then
      _cl_die "junie: proxy checkout not found at $repo_dir (set JUNIE_REPO)"
      return 1
    fi
    _cl_spawn_proxy junie "$port" \
      node "$repo_dir/dist/main.js" start --auth-token "$key" --port "$port" || return 1
  fi

  local models_json i
  for i in {1..20}; do
    models_json="$(_cl_fetch_json "http://localhost:$port/v1/models" "${JUNIE_AUTH_TOKEN:-}")"

    [[ -n "$models_json" && "$models_json" != "[]" && "$models_json" != '{"object":"list","data":[]}' ]] && break
    sleep 1
  done

  if [[ -z "$models_json" || "$models_json" == "[]" || "$models_json" == '{"object":"list","data":[]}' ]]; then
    _cl_die "junie: couldn't fetch models from :$port"
    return 1
  fi

  local tsv
  tsv="$(_cl_models_to_tsv "$models_json" "${_CL_PY_SORT}"'
import json, os
models = json.loads(os.environ["_CL_JSON"]).get("data", [])
rows = []
for m in models:
    mid = m.get("id", "")
    if not mid:
        continue
    desc = m.get("owned_by") or "Junie model"
    rows.append((mid, desc, ""))
rows.sort(key=_nkey)
for mid, desc, status in rows:
    print("%s\t%s\t%s" % (mid, desc, status))
')"

  local base
  base="$(_cl_select_model "Junie models (:$port)" "$tsv" "$model_override")" \
    || return 1

  local all fast sonnet
  all="$(echo "$tsv" | cut -f1)"
  sonnet="$(printf '%s\n' "$all" | \grep -i 'sonnet' | head -1)"
  fast="$(printf '%s\n' "$all" | \grep -iE 'haiku|mini|flash|lite' | head -1)"
  # If base is a Claude model, keep all companion roles on Claude to avoid
  # cross-provider routing that can fail with upstream auth on some IDs.
  if [[ "$base" == claude-* ]]; then
    sonnet="$base"
    fast="$base"
  fi
  : "${fast:=$base}" "${sonnet:=$base}"

  _cl_export_models "$base" "$fast" "$sonnet"
  _cl_log "Loaded: $ANTHROPIC_MODEL (junie, :$port)" \
          "— sonnet: $ANTHROPIC_DEFAULT_SONNET_MODEL," \
          "haiku/subagent: $ANTHROPIC_SMALL_FAST_MODEL"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Backend: Devin proxy (port 3003, this repository)
# ══════════════════════════════════════════════════════════════════════════════

_cl_backend_devin() {
  local model_override="${1:-}"
  local repo_dir="${DEVIN_PROXY_DIR:-$_CLD_SIBLINGS/WindsurfAPI}"
  local port="${DEVIN_PROXY_PORT:-}"
  if [[ -z "$port" && -f "$repo_dir/.env" ]]; then
    port="$(sed -n 's/^PORT=//p' "$repo_dir/.env" | tail -1)"
  fi
  port="${port:-3003}"
  local base_url="${DEVIN_PROXY_BASE_URL:-http://127.0.0.1:$port}"
  base_url="${base_url%/}"

  _cl_clear_env
  export ANTHROPIC_BASE_URL="$base_url"
  # Claude Code requires a token even when the local proxy allows anonymous use.
  local gateway_key="${DEVIN_PROXY_API_KEY:-${API_KEY:-}}"
  if [[ -z "$gateway_key" && -f "$repo_dir/.env" ]]; then
    gateway_key="$(sed -n 's/^API_KEY=//p' "$repo_dir/.env" | tail -1)"
    case "$gateway_key" in
      \"*\"|\'*\') gateway_key="${gateway_key:1:-1}" ;;
    esac
  fi
  export ANTHROPIC_AUTH_TOKEN="${gateway_key:-dummy}"

  if [[ -z "${DEVIN_PROXY_BASE_URL:-}" ]] && ! _cl_port_up "$port"; then
    if [[ ! -f "$repo_dir/src/index.js" ]]; then
      _cl_die "devin: proxy checkout not found at $repo_dir (set DEVIN_PROXY_DIR or DEVIN_PROXY_BASE_URL)"
      return 1
    fi
    _cl_spawn_proxy devinproxy "$port" \
      bash -c 'cd "$1" && exec env PORT="$2" node src/index.js' _ "$repo_dir" "$port" || return 1
  fi

  local models_json tsv
  models_json="$(_cl_fetch_json "$base_url/v1/models" "$gateway_key")"
  [[ -z "$models_json" ]] && { _cl_die "devin: couldn't fetch models from $base_url"; return 1; }
  tsv="$(_cl_models_to_tsv "$models_json" "${_CL_PY_SORT}"'
import json, os
models = json.loads(os.environ["_CL_JSON"]).get("data", [])
rows = [(m["id"], m.get("owned_by") or "", "") for m in models if m.get("id")]
rows.sort(key=_nkey)
for mid, label, status in rows:
    print("%s\t%s\t%s" % (mid, label, status))
')"
  [[ -z "$tsv" ]] && { _cl_die "devin: proxy returned no selectable models"; return 1; }

  local base
  base="$(_cl_select_model "Devin models ($base_url)" "$tsv" "$model_override")" \
    || return 1

  _cl_export_models "$base"
  _cl_log "Loaded: $ANTHROPIC_MODEL (devinproxy, $base_url)"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Backend: DeepSeek  (api.deepseek.com, direct API)
# ══════════════════════════════════════════════════════════════════════════════

_cl_backend_deepseek() {
  local model_override="${1:-}"

  _cl_clear_env
  export ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
  export ANTHROPIC_API_KEY="${DEEPSEEK_KEY:-}"

  local models_json
  models_json="$(_cl_fetch_json "https://api.deepseek.com/models" "$ANTHROPIC_API_KEY")"

  if [[ -z "$models_json" ]]; then
    _cl_die "deepseek: couldn't fetch models from API (is DEEPSEEK_KEY set?)"
    return 1
  fi

  local tsv
  tsv="$(_cl_models_to_tsv "$models_json" "${_CL_PY_SORT}"'
import json, os
models = json.loads(os.environ["_CL_JSON"])
rows = []
for m in models.get("data", []):
    mid = m.get("id", "")
    desc = "DeepSeek Reasoning Model" if "pro" in mid or "reasoner" in mid else "DeepSeek Standard Model"
    rows.append((mid, desc, ""))
rows.sort(key=_nkey)
for mid, desc, status in rows:
    print("%s\t%s\t%s" % (mid, desc, status))
')"

  local base
  base="$(_cl_select_model "DeepSeek models (api.deepseek.com)" "$tsv" "$model_override")" \
    || return 1

  local fast
  fast="$(echo "$tsv" | cut -f1 | \grep -i flash | head -1)"
  : "${fast:=$base}"

  _cl_export_models "$base" "$fast"
  export CLAUDE_CODE_EFFORT_LEVEL=low

  # Show remaining API balance
  local bal
  bal="$(_cl_fetch_json "https://api.deepseek.com/user/balance" "$ANTHROPIC_API_KEY" \
    | \grep -o '"total_balance":"[^"]*"' | cut -d'"' -f4)"
  [[ -n "$bal" ]] && _cl_log "Balance: \$$bal (deepseek)"
  _cl_log "Loaded: $ANTHROPIC_MODEL (api.deepseek.com)" \
          "— fast/subagent: $CLAUDE_CODE_SUBAGENT_MODEL"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Backend: Antigravity  (port 9080, local clone of antigravity-claude-proxy)
# ══════════════════════════════════════════════════════════════════════════════

# Run the locally patched clone, not the published `acc` bin. The released
# build ordered the dead cloudcode-pa prod endpoint first and lacks the
# signature-scrubbing and Claude max-token fixes, so `acc start` fails with a
# misleading 429 "quota exhausted" on every account.
# Models the quota API advertises but that do not actually serve. Verified
# 2026-09-17 by querying the Cloud Code API directly with a minted token:
#   gemini-2.5-pro      503 "No capacity available for model" — retired upstream
#   gemini-3.1-pro-high 400 INVALID_ARGUMENT under every request shape tried
#                       (no generationConfig; maxOutputTokens 16k and 65k;
#                       thinking budgets 128 and 10001). Its sibling
#                       gemini-3.1-pro-low answers fine, so it is the id that is
#                       dead, not the request. Picking it costs a ~2 min retry
#                       ladder before it gives up.
# Both are still listed by every proxy endpoint, so filter them here. Override to
# re-test, and prune entries that start working again:
#   AG_DEAD_MODELS="gemini-2.5-pro" source claudeload antigravity
_cl_backend_antigravity() {
  local model_override="${1:-}"
  local repo_dir="${AG_REPO:-$_CLD_SIBLINGS/antigravity-claude-proxy}"
  local port="${AG_PORT:-9080}"
  local dead_models="${AG_DEAD_MODELS:-gemini-2.5-pro gemini-3.1-pro-high}"
  local base_url="${AG_BASE_URL:-http://localhost:$port}"
  base_url="${base_url%/}"

  if [[ -z "${AG_BASE_URL:-}" ]] && ! _cl_port_up "$port" && [[ ! -f "$repo_dir/src/index.js" ]]; then
    _cl_die "antigravity: no clone at $repo_dir (set AG_REPO to the repo path)"
    return 1
  fi

  _cl_clear_env
  export ANTHROPIC_BASE_URL="$base_url"
  export ANTHROPIC_AUTH_TOKEN="${AG_AUTH_TOKEN:-test}"

  if [[ -z "${AG_BASE_URL:-}" ]]; then
    _cl_spawn_proxy antigravity "$port" \
      bash -c 'cd "$1" && exec env PORT="$2" node src/index.js' _ "$repo_dir" "$port" || return 1
  fi

  local models_json accounts_json health_json
  models_json="$(_cl_fetch_json "$base_url/v1/models" "${AG_AUTH_TOKEN:-}")"

  accounts_json="$(_cl_fetch_json "$base_url/api/accounts" "${AG_AUTH_TOKEN:-}")"
  health_json="$(_cl_fetch_json "$base_url/health" "${AG_AUTH_TOKEN:-}")"

  if [[ -z "$models_json" ]]; then
    _cl_die "antigravity: couldn't fetch models from $ANTHROPIC_BASE_URL (is the proxy + account working?)"
    return 1
  fi

  # Build the catalog of record from the proxy's own view of the account pool.
  #
  # /v1/models is not a full catalog: upstream hides every Gemini id below 3.5
  # ("curate /v1/models listing"), yet most of those still serve — only retired
  # ones 503. /api/accounts is worse: it exposes modelRateLimits, i.e. only the
  # models that have *already* hit a rate limit, so it is empty on a fresh proxy
  # or after any cooldown reset, and it can never list a healthy model. /health
  # reports the full per-account quota set, so use that as the source of truth
  # and fold in the listing for anything it doesn't cover.
  local catalog_json
  catalog_json="$(_AG_HEALTH="$health_json" _AG_MODELS="$models_json" \
                  _AG_DEAD="$dead_models" python3 -c '
import json, os
seen, ids, descs = set(), [], []
dead = set((os.environ.get("_AG_DEAD") or "").split())

def add(mid, desc=""):
    if mid and mid not in seen and mid not in dead:
        seen.add(mid)
        ids.append(mid)
        descs.append(desc)

try:
    for m in json.loads(os.environ.get("_AG_MODELS") or "{}").get("data", []):
        add(m.get("id"), m.get("description") or "")
except Exception:
    pass
try:
    for a in json.loads(os.environ.get("_AG_HEALTH") or "{}").get("accounts", []):
        for mid in (a.get("models") or {}):
            add(mid)
except Exception:
    pass

print(json.dumps({"object": "list",
                  "data": [{"id": i, "description": d} for i, d in zip(ids, descs)]}))
')"

  if [[ -z "$catalog_json" || "$catalog_json" == '{"object": "list", "data": []}' ]]; then
    _cl_die "antigravity: proxy reported no models (is an account healthy?)"
    return 1
  fi

  local tsv
  tsv="$(python3 "$_CLD_ROOT/bin/ag_format.py" "$catalog_json" "$accounts_json")"
  
  local base
  base="$(_cl_select_model "Antigravity models ($base_url)" "$tsv" "$model_override")" \
    || return 1

  # Use selected base model for fast/subagent companion to guarantee zero rate-limit collisions
  local fast="$base"

  if [[ "$base" == *claude* ]]; then
    # Cloud Code rejects streamGenerateContent for Claude models above 64000
    # (400 INVALID_ARGUMENT). Measured: 64000 passes, 100000 fails. The limit
    # only bites the streaming path, which is the only one Claude Code uses, so
    # an uncapped value here looks like a random hard failure.
    export CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000
  else
    # Gemini: the proxy caps this to its own GEMINI_MAX_OUTPUT_TOKENS (16384).
    export CLAUDE_CODE_MAX_OUTPUT_TOKENS=128000
  fi

  _cl_export_models "$base" "$fast"
  _cl_log "Loaded: $ANTHROPIC_MODEL (antigravity, $base_url)" \
          "— fast/subagent: $ANTHROPIC_SMALL_FAST_MODEL"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Backend: AI Studio  (port 9083, litellm proxy)
# ══════════════════════════════════════════════════════════════════════════════

_cl_backend_aistudio() {
  local model_override="${1:-}"
  local port="${AISTUDIO_PORT:-9083}"

  _cl_clear_env

  if [[ -z "${GEMINI_API_KEY:-}" ]]; then
    _cl_die "aistudio: GEMINI_API_KEY not found in env"
    return 1
  fi

  _cl_require_litellm "aistudio" || return 1

  local models_json
  models_json="$(_cl_fetch_json \
    "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY")"
  if [[ -z "$models_json" ]]; then
    _cl_die "aistudio: couldn't fetch models from API (is GEMINI_API_KEY valid?)"
    return 1
  fi

  # Generate litellm config from the live model catalog
  local config
  config="$(_cl_config_file "aistudio-$port-litellm.yaml")" || return 1
  python3 -c '
import json, sys
models = json.load(sys.stdin).get("models", [])
print("model_list:")
for m in models:
    name = m.get("name", "").replace("models/", "")
    print(f"  - model_name: {name}")
    print(f"    litellm_params:")
    print(f"      model: gemini/{name}")
    print(f"      api_key: os.environ/GEMINI_API_KEY")
' <<< "$models_json" > "$config"

  export ANTHROPIC_BASE_URL="http://localhost:$port"
  export ANTHROPIC_API_KEY=dummy
  _cl_spawn_proxy aistudio "$port" litellm --config "$config" --port "$port" || return 1

  local tsv
  tsv="$(_cl_models_to_tsv "$models_json" "${_CL_PY_SORT}"'
import json, os
models = json.loads(os.environ["_CL_JSON"]).get("models", [])
rows = []
for m in models:
    mid = m.get("name", "").replace("models/", "")
    desc = m.get("displayName", "")
    if "generateContent" not in m.get("supportedGenerationMethods", []):
        continue
    rows.append((mid, desc, ""))
rows.sort(key=_nkey)
for mid, desc, status in rows:
    print("%s\t%s\t%s" % (mid, desc, status))
')"

  local base
  base="$(_cl_select_model "Google AI Studio models (:$port)" "$tsv" "$model_override")" \
    || return 1

  local fast
  fast="$(echo "$tsv" | cut -f1 \
    | \grep -i flash | \grep -viE 'preview|lite|tts|image|transcribe|omni|latest|robotics' | tail -1)"
  : "${fast:=$base}"

  _cl_export_models "$base" "$fast"
  _cl_log "Loaded: $ANTHROPIC_MODEL (aistudio, :$port)" \
          "— fast/subagent: $ANTHROPIC_SMALL_FAST_MODEL"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Backend: OpenAI  (port 9084, litellm proxy)
# ══════════════════════════════════════════════════════════════════════════════

_cl_backend_openai() {
  local model_override="${1:-}"
  local port="${OPENAI_PROXY_PORT:-9084}"

  _cl_clear_env

  if [[ -z "${OPENAI_API_KEY:-}" ]]; then
    _cl_die "openai: OPENAI_API_KEY not found in env"
    return 1
  fi

  _cl_require_litellm "openai" || return 1

  local models_json
  models_json="$(_cl_fetch_json "https://api.openai.com/v1/models" "$OPENAI_API_KEY")"

  if [[ -z "$models_json" ]]; then
    _cl_die "openai: couldn't fetch models from API (is OPENAI_API_KEY valid?)"
    return 1
  fi

  # Generate litellm config from the live model catalog
  local config
  config="$(_cl_config_file "openai-$port-litellm.yaml")" || return 1
  python3 -c '
import json, sys
models = json.load(sys.stdin).get("data", [])
print("model_list:")
for m in models:
    mid = m.get("id", "")
    if any(x in mid for x in ["embedding", "whisper", "tts", "dall-e", "babbage", "davinci", "moderation", "text-search", "ada", "curie", "search", "similarity", "edit", "-transcribe", "image"]):
        continue
    print(f"  - model_name: {mid}")
    print(f"    litellm_params:")
    print(f"      model: openai/{mid}")
    print(f"      api_key: os.environ/OPENAI_API_KEY")
' <<< "$models_json" > "$config"

  export ANTHROPIC_BASE_URL="http://localhost:$port"
  export ANTHROPIC_API_KEY=dummy
  _cl_spawn_proxy openai "$port" env OPENAI_API_KEY="$OPENAI_API_KEY" litellm --config "$config" --port "$port" || return 1

  local tsv
  tsv="$(_cl_models_to_tsv "$models_json" "${_CL_PY_SORT}"'
import json, os
models = json.loads(os.environ["_CL_JSON"]).get("data", [])
rows = []
for m in models:
    mid = m.get("id", "")
    if any(x in mid for x in ["embedding", "whisper", "tts", "dall-e", "babbage", "davinci", "moderation", "text-search", "ada", "curie", "search", "similarity", "edit", "-transcribe", "image"]):
        continue
    desc = "OpenAI Reasoning Model" if mid.startswith("o") else "OpenAI Model"
    rows.append((mid, desc, ""))
rows.sort(key=_nkey)
for mid, desc, status in rows:
    print("%s\t%s\t%s" % (mid, desc, status))
')"

  local base
  base="$(_cl_select_model "OpenAI models (:$port)" "$tsv" "$model_override")" \
    || return 1

  local fast
  fast="$(echo "$tsv" | cut -f1 | \grep -iE "mini|nano|flash|lite" | tail -1)"
  : "${fast:=$base}"

  _cl_export_models "$base" "$fast"
  _cl_log "Loaded: $ANTHROPIC_MODEL (openai, :$port)" \
          "— fast/subagent: $ANTHROPIC_SMALL_FAST_MODEL"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Backend: Codex Proxy  (port 8081, Docker)
# ══════════════════════════════════════════════════════════════════════════════

_cl_backend_codexproxy() {
  local model_override="${1:-}"
  local base_url="${CODEX_PROXY_BASE_URL:-http://127.0.0.1:8081}"
  base_url="${base_url%/}"
  local key="${CODEX_PROXY_API_KEY:-}"
  local compose_dir="${CODEX_PROXY_DIR:-$_CLD_SIBLINGS/codex-proxy}"
  local key_file="${CODEX_PROXY_CONFIG:-$compose_dir/data/local.yaml}"

  _cl_clear_env

  # Prefer an explicitly supplied key.  The Docker setup stores its generated
  # local key in data/local.yaml; read it only when no override was supplied.
  if [[ -z "$key" && -r "$key_file" ]]; then
    key="$(sed -n 's/^[[:space:]]*proxy_api_key:[[:space:]]*//p' "$key_file" | head -n 1)"
    key="${key%%[[:space:]]#*}"
    key="${key#\"}"; key="${key%\"}"
    key="${key#\'}"; key="${key%\'}"
  fi
  if [[ -z "$key" || "$key" == "null" ]]; then
    _cl_die "codexproxy: API key unavailable — set CODEX_PROXY_API_KEY or log in to the local dashboard"
    return 1
  fi

  # Start only the known local default. Custom URLs point to existing services.
  if [[ "$base_url" == "http://127.0.0.1:8081" || "$base_url" == "http://localhost:8081" ]] && ! _cl_port_up 8081; then
    if ! command -v docker >/dev/null 2>&1 || [[ ! -f "$compose_dir/docker-compose.yml" ]]; then
      _cl_die "codexproxy: Docker Compose setup not found at $compose_dir"
      return 1
    fi
    _cl_spawn_proxy codexproxy 8081 \
      bash -c 'cd "$1" && exec docker compose up' _ "$compose_dir" || return 1
    if ! _cl_port_up 8081; then
      _cl_die "codexproxy: :8081 did not become ready after 30 seconds"
      return 1
    fi
  fi

  export ANTHROPIC_BASE_URL="$base_url"
  export ANTHROPIC_API_KEY="$key"

  # Fetch the extended catalog for useful labels and availability metadata.
  # Fall back to the standard OpenAI model list if the extended endpoint is
  # unavailable on an older Codex Proxy image. After an on-demand Docker
  # start, allow time for the authenticated account's catalog refresh.
  local models_json i
  for i in {1..15}; do
    models_json="$(_cl_fetch_json "$base_url/v1/models/catalog" "$key")"

    [[ -z "$models_json" ]] && models_json="$(_cl_fetch_json "$base_url/v1/models" "$key")"

    [[ -n "$models_json" && "$models_json" != "[]" && "$models_json" != '{"object":"list","data":[]}' ]] && break
    sleep 1
  done
  if [[ -z "$models_json" || "$models_json" == "[]" || "$models_json" == '{"object":"list","data":[]}' ]]; then
    _cl_die "codexproxy: no models available — log in to the dashboard, then restart the Docker container"
    return 1
  fi

  local tsv
  tsv="$(_cl_models_to_tsv "$models_json" "${_CL_PY_SORT}"'
import json, os
payload = json.loads(os.environ["_CL_JSON"])
models = payload.get("data", []) if isinstance(payload, dict) else payload
rows = []
for m in models:
    mid = m.get("id", "")
    if not mid:
        continue
    desc = m.get("displayName") or m.get("description") or "Codex model"
    upgrade = m.get("upgrade") or {}
    status = ("upgrade → %s" % upgrade.get("model")) if upgrade.get("model") else ""
    rows.append((mid, desc, status))
rows.sort(key=_nkey)
for mid, desc, status in rows:
    print("%s\t%s\t%s" % (mid, desc, status))
')"

  local base
  base="$(_cl_select_model "Codex Proxy models ($base_url)" "$tsv" "$model_override")" \
    || return 1

  # Derive companion roles from the live catalog. Prefer current, stable Codex
  # families: Terra for balanced work and Luna for inexpensive parallel work.
  # Preview-only models are fallback choices, not the default subagent tier.
  local all fast sonnet
  all="$(echo "$tsv" | cut -f1)"
  sonnet="$(printf '%s\n' "$all" | \grep -x 'gpt-5.6-terra' | head -1)"
  [[ -z "$sonnet" ]] && sonnet="$(printf '%s\n' "$all" | \grep -i 'terra' | head -1)"
  fast="$(printf '%s\n' "$all" | \grep -x 'gpt-5.6-luna' | head -1)"
  [[ -z "$fast" ]] && fast="$(printf '%s\n' "$all" | \grep -iE 'luna|mini' | \grep -vi 'preview' | head -1)"
  [[ -z "$fast" ]] && fast="$(printf '%s\n' "$all" | \grep -i 'spark' | head -1)"
  : "${fast:=$base}" "${sonnet:=$base}"

  _cl_export_models "$base" "$fast" "$sonnet"
  _cl_log "Loaded: $ANTHROPIC_MODEL (codexproxy, $base_url)" \
          "— sonnet: $ANTHROPIC_DEFAULT_SONNET_MODEL," \
          "haiku/subagent: $ANTHROPIC_SMALL_FAST_MODEL"
}

# ══════════════════════════════════════════════════════════════════════════════
# ══════════════════════════════════════════════════════════════════════════════
#  Backend: OmniRoute  (port 20128, omniroute serve)
# ══════════════════════════════════════════════════════════════════════════════

_cl_backend_omniroute() {
  local model_override="${1:-}"
  local base_url="${OMNIROUTE_BASE_URL:-http://localhost:20128/v1}"
  base_url="${base_url%/}"

  _cl_clear_env

  if [[ -z "${OMNIROUTE_KEY:-}" ]]; then
    _cl_warn "omniroute: OMNIROUTE_KEY not found in env (continuing anyway)"
  fi

  export ANTHROPIC_BASE_URL="$base_url"
  export ANTHROPIC_API_KEY="${OMNIROUTE_KEY:-sk-dummy}"
  export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

  if [[ -z "${OMNIROUTE_BASE_URL:-}" ]]; then
    if ! _cl_port_up 20128 && ! command -v omniroute >/dev/null 2>&1; then
      _cl_die "omniroute: command not found (install it or set OMNIROUTE_BASE_URL)"
      return 1
    fi
    _cl_spawn_proxy omniroute 20128 omniroute serve --log --no-open || return 1
  fi

  local models_json active_providers i
  for i in {1..15}; do
    models_json="$(_cl_fetch_json "$base_url/models" "$ANTHROPIC_API_KEY")"
    # A local OmniRoute install can identify which catalog providers are active.
    if [[ -n "$models_json" && -z "${OMNIROUTE_BASE_URL:-}" ]] && command -v omniroute >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
      active_providers="$(omniroute providers list | awk '/active/{print $2}' | paste -sd "," -)"
      if [[ -n "$active_providers" ]]; then
        models_json="$(printf '%s' "$models_json" | jq --arg providers "$active_providers" '.data = [.data[] | select(.owned_by as $o | ($providers | contains($o)) and (.id | test("-low$|-medium$|-high$|-xhigh$|-tiered$|^auto/|/auto$|^kiro/|^gemini-web/") | not))]')"
      fi
    fi

    [[ -n "$models_json" && "$models_json" != "[]" && "$models_json" != '{"object":"list","data":[]}' ]] && break
    sleep 1
  done

  if [[ -z "$models_json" || "$models_json" == "[]" || "$models_json" == '{"object":"list","data":[]}' ]]; then
    _cl_die "omniroute: couldn't fetch models from $base_url"
    return 1
  fi

  local tsv
  tsv="$(_cl_models_to_tsv "$models_json" "${_CL_PY_SORT}"'
import json, os
try:
    payload = json.loads(os.environ["_CL_JSON"])
    models = payload.get("data", []) if isinstance(payload, dict) else payload
except Exception:
    models = []
rows = []
for m in models:
    if isinstance(m, dict):
        mid = m.get("id", "")
        if not mid:
            continue
        desc = m.get("name") or mid or "OmniRoute model"
        rows.append((mid, desc, ""))
rows.sort(key=_nkey)
for mid, desc, status in rows:
    print("%s\t%s\t%s" % (mid, desc, status))
')"

  local base
  base="$(_cl_select_model "OmniRoute models ($base_url)" "$tsv" "$model_override")" \
    || return 1

  local all fast sonnet
  all="$(echo "$tsv" | cut -f1)"
  sonnet="$(printf '%s\n' "$all" | \grep -i 'sonnet' | head -1)"
  fast="$(printf '%s\n' "$all" | \grep -iE 'haiku|mini|flash|lite' | head -1)"
  : "${fast:=$base}" "${sonnet:=$base}"

  _cl_export_models "$base" "$fast" "$sonnet"
  _cl_log "Loaded: $ANTHROPIC_MODEL (omniroute, $base_url)" \
          "— sonnet: $ANTHROPIC_DEFAULT_SONNET_MODEL," \
          "haiku/subagent: $ANTHROPIC_SMALL_FAST_MODEL"
}

# ══════════════════════════════════════════════════════════════════════════════
#  Backend: Strata  (run-uncensored.sh)
# ══════════════════════════════════════════════════════════════════════════════

_cl_backend_strata() {
  local model_override="${1:-}"
  local repo_dir="${STRATA_REPO:-$_CLD_SIBLINGS/Strata}"
  local launcher="$repo_dir/run-uncensored.sh"
  local port="${STRATA_PORT:-}"
  if [[ -z "$port" && -f "$launcher" ]]; then
    port="$(sed -nE 's/.*--port[[:space:]]+([0-9]+).*/\1/p' "$launcher" | tail -1)"
  fi
  port="${port:-8090}"
  local base_url="${STRATA_BASE_URL:-http://127.0.0.1:$port}"
  base_url="${base_url%/}"

  _cl_clear_env

  export ANTHROPIC_BASE_URL="$base_url"
  export ANTHROPIC_AUTH_TOKEN="${STRATA_AUTH_TOKEN:-test}"

  if [[ -z "${STRATA_BASE_URL:-}" ]]; then
    if ! _cl_port_up "$port" && [[ ! -f "$launcher" ]]; then
      _cl_die "strata: proxy checkout not found at $repo_dir (set STRATA_REPO)"
      return 1
    fi
    _cl_spawn_proxy strata "$port" \
      bash -c 'cd "$1" && exec ./run-uncensored.sh --port "$2"' _ "$repo_dir" "$port" || return 1
  fi

  local models_json i
  for ((i=0; i<15; i++)); do
    models_json="$(_cl_fetch_json "$base_url/v1/models" "${STRATA_AUTH_TOKEN:-}")"
    [[ -n "$models_json" && "$models_json" != "[]" && "$models_json" != '{"object":"list","data":[]}' ]] && break
    sleep 1
  done

  if [[ -z "$models_json" || "$models_json" == "[]" || "$models_json" == '{"object":"list","data":[]}' ]]; then
    _cl_die "strata: couldn't fetch models from $base_url"
    return 1
  fi

  local tsv
  tsv="$(_cl_models_to_tsv "$models_json" "${_CL_PY_SORT}"'
import json, os
try:
    models = json.loads(os.environ["_CL_JSON"]).get("data", [])
except Exception:
    models = []
rows = []
for m in models:
    mid = m.get("id", "")
    if not mid: continue
    rows.append((mid, "Strata local model", ""))
rows.sort(key=_nkey)
for mid, desc, status in rows:
    print("%s\t%s\t%s" % (mid, desc, status))
')"

  local base
  base="$(_cl_select_model "Strata models ($base_url)" "$tsv" "$model_override")" \
    || return 1

  _cl_export_models "$base"

  # Claude Code never asks a gateway for the window: an unrecognised model ID
  # is assumed to be 200k.  Declare the engine's real one, so the context meter
  # and proactive auto-compaction both use it.  Keep this equal to the config's
  # --max-context (strata-uncensored-ud-q4_k_xl.json).
  export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${STRATA_CONTEXT_TOKENS:-131072}"

  _cl_log "Loaded: $ANTHROPIC_MODEL (strata, $base_url)" \
          "— context: $CLAUDE_CODE_MAX_CONTEXT_TOKENS (declared)"
}

#  Main Dispatch
# ══════════════════════════════════════════════════════════════════════════════

case "${1:-}" in
  ""|menu|m)
    if _prof="$(_cl_pick "Choose Claude Code backend" $'omniroute\tOmniRoute Server\nstrata\tStrata local Qwen Coder\ncodexproxy\tCodex Proxy (Docker)\nopenai\tOpenAI via LiteLLM\ncopilot\tGitHub Copilot proxy\njunie\tJetBrains Junie proxy\ndevin\tDevin proxy\ndeepseek\tDeepSeek direct API\nantigravity\tAntigravity account proxy\naistudio\tGoogle AI Studio via LiteLLM')"; then
      source "$_CLD_SELF" "$_prof"
    else
      echo "  cancelled" >&2
      false
    fi
    ;;

  copilot|cop|opus)    _cl_backend_copilot   "${2:-}" ;;
  junie|jb)            _cl_backend_junie     "${2:-}" ;;
  devin|dv)            _cl_backend_devin     "${2:-}" ;;
  deepseek)            _cl_backend_deepseek  "${2:-}" ;;
  antigravity|ag)      _cl_backend_antigravity "${2:-}" ;;
  aistudio|ai)         _cl_backend_aistudio  "${2:-}" ;;
  openai|chatgpt|oai)  _cl_backend_openai    "${2:-}" ;;
  codexproxy|codex-proxy|codex|cp) _cl_backend_codexproxy "${2:-}" ;;
  omniroute|or)        _cl_backend_omniroute "${2:-}" ;;
  strata|st)           _cl_backend_strata    "${2:-}" ;;

  status|s)
    _cl_print_status
    ;;

  *)
    cat <<'EOF'
claudeload — switch Claude Code backend

  (no args)   interactive menu: pick backend → pick model
  copilot     GitHub Copilot proxy
  junie       JetBrains Junie proxy
  devin       interactive: pick a live model from Devin proxy
  deepseek    DeepSeek models (api.deepseek.com)
  antigravity Antigravity account proxy
  aistudio    Google AI Studio via LiteLLM
  openai      OpenAI via LiteLLM
  codexproxy  Codex Proxy via Docker
  omniroute   OmniRoute server
  strata      Strata local Qwen Coder
  status      show current config

Usage: source /path/to/MyDots/bin/claudeload <profile> [model]
Proxies run in tmux session 'proxies' when a local service is needed.
Local checkouts default to sibling directories of this repo. Override with
JUNIE_REPO, DEVIN_PROXY_DIR, AG_REPO, CODEX_PROXY_DIR, or STRATA_REPO.
Existing services can be selected with COPILOT_BASE_URL, DEVIN_PROXY_BASE_URL,
AG_BASE_URL, CODEX_PROXY_BASE_URL, OMNIROUTE_BASE_URL, or STRATA_BASE_URL.
Use the service origin for these URLs; OMNIROUTE_BASE_URL includes /v1.
Set DEVIN_PROXY_API_KEY for a protected Devin proxy. Local port overrides:
JUNIE_PORT, DEVIN_PROXY_PORT, AG_PORT, AISTUDIO_PORT, OPENAI_PROXY_PORT,
STRATA_PORT.
COPILOT_AUTH_TOKEN, JUNIE_AUTH_TOKEN, AG_AUTH_TOKEN, and STRATA_AUTH_TOKEN
configure authentication for those proxies when needed.
COPILOT_ACCOUNT_TYPE, STRATA_CONTEXT_TOKENS, and CLAUDELOAD_MAX_OUTPUT_TOKENS
override their respective defaults.
EOF
    ;;
esac
_CLD_RESULT=$?

# ── Global flags (applied regardless of backend) ─────────────────────────────
export DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# Third-party proxy models aren't in Claude Code's built-in registry, so it
# can't guess their context window.  A backend that knows its window declares
# CLAUDE_CODE_MAX_CONTEXT_TOKENS (strata does); that keys proactive compaction
# off the real window.  This switch instead stops compaction until the API
# refuses a request with an error Claude Code recognises - and a gateway can
# word that error so it never does.  Only fall back to it with no window.
if [[ -z "${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-}" ]]; then
  export CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1
fi
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  exit "$_CLD_RESULT"
fi
return "$_CLD_RESULT"
